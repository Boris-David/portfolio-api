{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-api",
  "main": "src/worker.ts",

  // Les API de la plateforme sont figées à cette date : une mise à jour de
  // workerd ne peut pas changer le comportement du Worker sans qu'on l'ait
  // décidé en avançant cette ligne.
  "compatibility_date": "2026-09-17",

  // `node:crypto` sert à condenser le contenu servi (ETag, version). workerd
  // l'implémente et rend le MÊME octet que Node — vérifié, donc l'empreinte
  // calculée au build et celle calculée dans l'isolat sont comparables.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // Les CV rendus. Ils pèsent ~330 Ko chacun et le script gratuit est
    // plafonné à 1 Mo compressé : ils ne peuvent pas y être embarqués.
    "directory": "./public",
    "binding": "ASSETS",

    // Le Worker répond avant le magasin sur les chemins bruts des CV. Sans
    // cela, chaque PDF aurait DEUX URL publiques — la route documentée et son
    // chemin d'asset — dont une servie sans nos en-têtes. Le binding, lui,
    // atteint le magasin directement : c'est par là que la route les relaie.
    "run_worker_first": ["/cv/*"],
  },

  // Le domaine est enregistré chez Cloudflare Registrar, donc la zone est déjà
  // sur le compte : `wrangler deploy` crée le domaine personnalisé lui-même.
  // Rien à cliquer, et la configuration reste dans le dépôt.
  "routes": [{ "pattern": "api.amissan.dev", "custom_domain": true }],

  "observability": { "enabled": true },
}
