{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-api",
  "main": "src/worker.ts",

  // The platform APIs are frozen at this date: a workerd update cannot change
  // the Worker's behaviour unless we decide it by moving this line forward.
  "compatibility_date": "2026-09-17",

  // `node:crypto` is what digests the content served (ETag, version). workerd
  // implements it and returns the SAME byte as Node — verified, so the digest
  // computed at build time and the one computed inside the isolate compare.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // The rendered résumés. They weigh ~330 KB each and the free script is
    // capped at 1 MB compressed: they cannot be bundled into it.
    "directory": "./public",
    "binding": "ASSETS",

    // The Worker answers before the store on the raw résumé paths. Without
    // this, every PDF would have TWO public URLs — the documented route and
    // its asset path — one of them served without our headers. The binding
    // reaches the store directly: that is how the route relays them.
    "run_worker_first": ["/cv/*"],
  },

  // The domain is registered with Cloudflare Registrar, so the zone is already
  // on the account: `wrangler deploy` creates the custom domain itself. Nothing
  // to click, and the configuration stays in the repo.
  "routes": [{ "pattern": "api.amissan.dev", "custom_domain": true }],

  "observability": { "enabled": true },
}
