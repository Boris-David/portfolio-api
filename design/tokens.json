{
  "$comment": "The single source of design. The web CSS, the PDF résumé template and the Swift design system package are all GENERATED from here — no value is ever copied by hand. See ADR 0003 and 0004.",
  "font": {
    "display": { "family": "Fraunces", "fallback": "Georgia, serif", "variable": true, "axes": ["opsz", "wght"] },
    "text":    { "family": "Instrument Sans", "fallback": "Helvetica Neue, system-ui, sans-serif" },
    "mono":    { "family": "ui-monospace", "fallback": "SFMono-Regular, monospace" }
  },
  "color": {
    "paper":     { "light": "#FAF8F3", "dark": "#14120F" },
    "paper-2":   { "light": "#F1EDE3", "dark": "#1C1915" },
    "paper-3":   { "light": "#E7E1D6", "dark": "#262119" },
    "line":      { "light": "#E0D9CC", "dark": "#2E2921" },
    "line-2":    { "light": "#C9C1B1", "dark": "#3E3930" },
    "ink":       { "light": "#1A1712", "dark": "#F3EFE7" },
    "ink-2":     { "light": "#3E3930", "dark": "#D2CBBC" },
    "ink-3":     { "light": "#5B5546", "dark": "#9A9384" },
    "accent":    { "light": "#2743D6", "dark": "#93A5FF" },
    "accent-d":  { "light": "#1C2F9C", "dark": "#B6C1FF" },
    "accent-w":  { "light": "#CBD3FF", "dark": "#1E2650" },
    "on-accent": { "light": "#FFFFFF", "dark": "#0E1330" },
    "ok":        { "light": "#1E7F4F", "dark": "#4FBE86" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 72, "9": 104 },
  "radius": { "sm": 7, "md": 12, "lg": 14, "pill": 999 },
  "ease": {
    "out":  "cubic-bezier(.22,1,.36,1)",
    "soft": "cubic-bezier(.16,1,.3,1)",
    "io":   "cubic-bezier(.65,.02,.28,1)",
    "back": "cubic-bezier(.34,1.42,.64,1)"
  },
  "type": {
    "$comment": "A scale aligned with the iOS Dynamic Type scale — base 17.",
    "caption": 13, "subhead": 15, "body": 17, "title3": 21, "title1": 28, "large": 34
  },
  "a11y": { "minTouchTarget": 44, "contrast": "AA" }
}
